{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/kontakt",
      "destination": "/#kontakt",
      "permanent": true
    },
    {
      "source": "/ueber-mich",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/editorfolio",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/danke",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/preise",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sonderangebot",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sonderangebot-webseite",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/webseiten-erstellung",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/fullstack-entwicklung",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/digitalisierung",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/(fonts|img)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
